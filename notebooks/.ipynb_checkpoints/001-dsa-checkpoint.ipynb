    "def get_all_digits(number: int) -> None:\n",
    "    \"\"\"method to get all digits from the given number\"\"\"\n",
    "\n",
    "    while number>0:\n",
    "        last = number % 10\n",
    "        print(last)\n",
    "        number = number // 10"
   ]
